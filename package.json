    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@google/genai": "^1.33.0",
    "@mediapipe/tasks-vision": "0.10.9",
    "@supabase/supabase-js": "^2.45.0",
    "bcrypt-ts": "^8.0.1",
    "bcryptjs": "2.4.3",
    "framer-motion": "^12.35.2",
    "html5-qrcode": "^2.3.8",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.8.2",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "qrcode.react": "^3.1.0",
