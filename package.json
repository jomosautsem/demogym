{
  "name": "kaacc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "node-domexception": "file:./utils/node-domexception-shim"
  },
  "description": "Kali Access - Sistema de Control de Acceso Deportivo y Biometría DigitalPersona",
  "author": "Kali Deportivo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "build:native": "dotnet publish native/KaliAccessBiometric/KaliAccessBiometric.csproj -c Release -r win-x64 --self-contained false",
    "electron:dev": "npm run build && electron .",
    "electron:start": "electron .",
    "electron:pack": "npm run build && npm run build:native && electron-builder --dir --config electron-builder.json",
    "electron:build": "npm run build && npm run build:native && electron-builder --config electron-builder.json"
  },
  "dependencies": {
